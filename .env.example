# ========================================
# Configuration - Pétition Agro Bioénergies
# ========================================
# Copier en .env pour personnaliser :  cp .env.example .env
# Utilisé par docker-compose.yml (déploiement manuel / deploy.sh).
# Sur Coolify, définir ces variables dans l'onglet "Environment Variables".

# Port exposé sur l'hôte (non utilisé avec Coolify : le proxy route vers le port 80)
PORT=3000

# Fuseau horaire
TZ=Europe/Paris

# Nom du conteneur
CONTAINER_NAME=petition-agro

# Politique de redémarrage
RESTART_POLICY=unless-stopped
