# ========================================
# Configuration - Pétition Agro Bioénergies
# ========================================
# Déploiement manuel : cp .env.example .env
# Coolify : définir ADMIN_USER / ADMIN_PASSWORD dans "Environment Variables"
#           (les autres variables sont inutiles sur Coolify).

# Identifiants de l'export PDF (/admin/export.pdf) - OBLIGATOIRE
ADMIN_USER=admin
ADMIN_PASSWORD=changez-moi

# Port exposé sur l'hôte (docker-compose uniquement)
PORT=3000

# Fuseau horaire
TZ=Europe/Paris

# Nom du conteneur
CONTAINER_NAME=petition-agro

# Politique de redémarrage
RESTART_POLICY=unless-stopped
